<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Adaptive-icon background layer: full 108 bleed, because the launcher
         mask can crop anywhere from a circle to a squircle and anything short
         of the full canvas would show a corner of nothing.

         Flat, with no radial glow behind the mark: a soft gold disc under a
         gold mark reads as a smudge at launcher size, and on the Google TV
         row every neighbouring tile is flat. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:offset="0" android:color="#FF241C10" />
                <item android:offset="1" android:color="#FF0E0D0C" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
